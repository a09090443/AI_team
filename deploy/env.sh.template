#!/usr/bin/env bash
#
# 複製到 VM 上的 ~/ai-team/env.sh，填入實際值，然後：
#     chmod 600 ~/ai-team/env.sh
#     source ~/ai-team/env.sh
#
# 這個檔案由「你」填寫，不要貼給我，也不要 commit 進 git。
# 我只需要知道「填好了」，不需要知道值。

# ---- Slack ----------------------------------------------------------
# App-Level Token。在 api.slack.com 的 Basic Information → App-Level Tokens
# 建立，scope 選 connections:write。格式 xapp-...
export SLACK_APP_TOKEN=""

# Bot User OAuth Token。OAuth & Permissions → Install to Workspace 之後取得。
# 格式 xoxb-...
export SLACK_BOT_TOKEN=""

# 五個角色各自的 Bot Token（QA 規劃與驗收共用 QA App）。
# 填了就以該角色的真實身分發言 —— 會出現在成員清單、有自己的個人檔案與頭像、
# 可以被個別 @ 提及。留空則退回主 token 加上名稱／圖示覆寫，功能不受影響。
# 記得把每個 App 都邀請進 AI 團隊所在的頻道，否則它們貼不進去。
export SLACK_BOT_TOKEN_PM=""
export SLACK_BOT_TOKEN_ARCHITECTURE=""
export SLACK_BOT_TOKEN_BACKEND=""
export SLACK_BOT_TOKEN_QA=""
export SLACK_BOT_TOKEN_CODE_REVIEW=""
# bestpartner 配置式團隊的 Infrastructure Agent；未使用此角色的實例保持空白。
export SLACK_BOT_TOKEN_INFRASTRUCTURE=""

# ---- 各角色使用的模型 --------------------------------------------------
# 留空＝用 claude CLI 的預設（目前是 sonnet）。可填別名或完整模型 ID。
# 實測可用的別名：sonnet（claude-sonnet-5）、opus（claude-opus-5）、haiku（claude-haiku-4-5）。
# 打錯名稱不會安靜退回預設，claude 會以結束碼 1 失敗 —— 這是刻意的。
#
# 選擇建議（依實測的階段特性）：
#   PM           判斷要不要啟動下游、要不要架構決策。判斷不穩會讓整條管線走偏，
#                值得用強一點的模型；但它每次只跑約一分鐘，成本影響最小。
#   ARCHITECTURE 要讀很多既有程式碼並推理相容性，最吃推理品質。
#   BACKEND      長時間執行、成本最高的一段。換強模型時成本放大最明顯。
#   QA           要看出「測試通過但沒測到對的東西」，需要判斷力。
export AI_TEAM_MODEL_PM="opus"
export AI_TEAM_MODEL_ARCHITECTURE="opus"
export AI_TEAM_MODEL_BACKEND="sonnet"
export AI_TEAM_MODEL_QA="sonnet"
export AI_TEAM_MODEL_CODE_REVIEW=""
export AI_TEAM_RUNTIME_PM="claude-code"
export AI_TEAM_RUNTIME_ARCHITECTURE="claude-code"
export AI_TEAM_RUNTIME_BACKEND="claude-code"
export AI_TEAM_RUNTIME_QA="claude-code"
export AI_TEAM_RUNTIME_CODE_REVIEW="codex"
export AI_TEAM_CODE_REVIEW="on"

# 允許觸發的 Slack user ID，以逗號分隔（不是 @顯示名稱）。
# 取得方式：Slack 中點你的頭像 → 檢視完整個人檔案 → 右側 ⋯ → 複製成員 ID
# 例：U01ABCDEFGH,U02IJKLMNOP
export AI_TEAM_ALLOWED_USERS=""

# 要運作的頻道 ID。現行 preflight 視為必填；請填專用頻道，不可留空。
# 取得方式：在 Slack 中該頻道 → 檢視頻道詳細資料 → 底部的頻道 ID
export AI_TEAM_CHANNEL_ID=""

# ---- 專案路徑 --------------------------------------------------------
export AI_TEAM_HOME="$HOME/ai-team"
export AI_TEAM_REPO="$AI_TEAM_HOME/zipe-spring-boot-starters"
export AI_TEAM_WORKSPACES="$AI_TEAM_HOME/workspaces"
export AI_TEAM_LOGS="$AI_TEAM_HOME/logs"

# ---- Runtime --------------------------------------------------------
# claude 執行檔的絕對路徑（已依實機安裝位置填好）。
export CLAUDE_BIN="$HOME/.local/node/bin/claude"

# codex 執行檔的絕對路徑。只有在下面把某個角色指定成 codex 時才需要 ——
# 沒指定的話留著不填也不影響啟動。
# 安裝：npm install -g @openai/codex
# 認證：codex login --device-auth（headless 環境唯一乾淨的路徑）
export CODEX_BIN="$HOME/.local/node/bin/codex"

# opencode 執行檔的絕對路徑。同樣只有在下面把某個角色指定成 opencode 時才需要。
# 安裝：npm install -g opencode-ai
# 認證：opencode providers（別名 auth）；憑證寫在 ~/.local/share/opencode/auth.json
# 注意：opencode 多半是接 API key 計費的供應商（例如 OpenRouter），
# 與 claude／codex 的訂閱制不同，成本是逐次累加的 —— 見 docs-site/docs/opencode-runtime-report.md。
#export OPENCODE_BIN="$HOME/.local/node/bin/opencode"

# 每個角色要用的 runtime：claude-code（預設）、codex 或 opencode。
# 留空一律退回 claude-code，既有部署不受影響。
#
# 注意：模型名三家都不通用。
#   codex    收到不認識的模型名不會拒絕，而是退回 fallback metadata 繼續跑
#            （2026-09 實測）。
#   opencode 模型格式是 provider/model（例如 openrouter/openai/gpt-oss-20b），
#            填錯會以 error 事件加結束碼 1 收場（見 docs-site/docs/opencode-runtime-report.md）。
# 換 runtime 時 AI_TEAM_MODEL_<角色> 一定要一併清掉或換成該 CLI 認得的名稱。
#export AI_TEAM_RUNTIME_PM=codex
#export AI_TEAM_RUNTIME_ARCHITECTURE=codex
#export AI_TEAM_RUNTIME_BACKEND=codex
#export AI_TEAM_RUNTIME_QA=codex
#export AI_TEAM_RUNTIME_CODE_REVIEW=opencode

# 全域並行上限。訂閱帳號下建議維持 1，避免額度暴衝。
export AI_TEAM_MAX_CONCURRENCY=1

# 全域逾時覆寫（秒）。0 表示採用各階段自己的值 —— 這是預設也是建議值。
# 各階段成本差很多：PM 約一分鐘，Backend 光跑一次 mvn verify 就要兩分鐘，
# 所以 PM/Architecture 用 900 秒、Backend/QA 用 1800 秒（定義在 StageSpec）。
# 這個變數只在「現在就是想全部縮短或拉長」時才設。
export AI_TEAM_TASK_TIMEOUT_SECONDS=0
export AI_TEAM_GIT_TIMEOUT_SECONDS=300

# ---- git 與 PR ------------------------------------------------------
# 開分支的基準。留空表示自動判斷：遠端有 develop 就用 develop，否則用
# origin 的預設分支。對走 gitflow 的專案，從 master 開分支會做出一個
# 永遠合不進去的 PR，所以這裡的預設行為刻意偏向 develop。
export AI_TEAM_BASE_BRANCH=""

# 任務分支前綴。預設符合 zipe-spring-boot-starters 的 feature → develop → master 流程。
export AI_TEAM_BRANCH_PREFIX="feature/ai-team-task-"

# Agent 產生的 commit 署名。寫在工作區的 local config，不會動到你的 ~/.gitconfig。
export AI_TEAM_GIT_USER_NAME="AI Team"
export AI_TEAM_GIT_USER_EMAIL="ai-team@localhost"

# 推分支與開 PR 用的 GitHub token。留空的話管線一樣跑得完，
# 只是核准之後推不出去（啟動時會警告，按下核准時會給明確訊息）。
# classic token 需 repo scope；fine-grained 需 Contents:write 與 Pull requests:write。
export AI_TEAM_GITHUB_TOKEN=""

# ---- 認證備註 --------------------------------------------------------
# 使用 Claude 訂閱帳號時，「不要」設定 ANTHROPIC_API_KEY，
# 讓 claude 讀取 `claude` 互動登入後留下的 OAuth 憑證。
# 同時也「不能」使用 --bare（--bare 不讀 OAuth 憑證）。
unset ANTHROPIC_API_KEY
## 角色直接對話：各 App 自己的 App-Level Token（connections:write）。
## 空白保留舊版唯寫模式；不可共用主 App 的 xapp token。
export SLACK_APP_TOKEN_PM=""
export SLACK_APP_TOKEN_ARCHITECTURE=""
export SLACK_APP_TOKEN_BACKEND=""
export SLACK_APP_TOKEN_QA=""
export SLACK_APP_TOKEN_CODE_REVIEW=""
export SLACK_APP_TOKEN_INFRASTRUCTURE=""
# 配置式團隊（空白只保留 legacy 模式）。填管理者控管的絕對路徑；修改後重啟，新任務才採用。
#
# 也可以改放在 ~/ai-team/team.env（同樣 600）。start.sh 與 preflight.sh 會在
# 讀完 env.sh 之後再讀 team.env，兩邊都有時以 team.env 為準。
# 用途是把「切換團隊配置」與「含憑證的 env.sh」分開，不必為了換 profile 動憑證檔。
# backup.sh 會一併備份 team.env；不需要 profile 的部署可以完全不建立它。
export AI_TEAM_DEFINITION=""

# 服務實例名稱（非機密，建議放 team.env）。同一台 VM 只跑一個服務時留空即可。
# 每個專案各跑一個服務時**必填且各實例不可重複**：systemd unit 會改名為 ai-team-<實例>-…，
# 否則「中斷這一輪」可能停掉另一個專案同編號任務的 agent。preflight 偵測到其他實例在跑而本項為空時會失敗。
# 格式：小寫英文字母開頭、只含小寫英數、最多 16 字；不可為 check／preflight／selftest／codex。
# export AI_TEAM_INSTANCE="starters"

# Gradle 專案（例如 bestpartner）才需要。Gradle 要寫整個 user home，沙箱內 ~/.gradle 是唯讀，
# 所以改指向已核准的快取路徑，並在團隊配置 cachePaths 宣告 ".cache/gradle"。Maven 專案留著註解即可。
# export GRADLE_USER_HOME="$HOME/.cache/gradle"

# Slack 階段進度回報的間隔（秒）。預設 300 秒，最小 30 秒（設更小會被夾回 30）。
# 這張卡是系統代發的狀態卡，只說明角色／節點與耗時，不代表工具活動或驗收結果。
#
# 保持註解掉＝採用預設值。這一項是數值型設定，**不能設成空字串**：
# 空字串仍算「有設定」，會在啟動時轉型失敗，服務起不來。要改就填實際秒數。
#export AI_TEAM_PROGRESS_INTERVAL_SECONDS=600

# 階段回報的詳細程度：brief（預設）或 full。
# brief 只貼判定／摘要／阻礙／建議後續，其餘欄位以「另有 N 個欄位未顯示」帶過；
# 完整報告沒有消失，仍存在 stage_result，可用「補充 #<ID> 檢視完整報告 [節點]」叫出來。
# 受阻原因不受這個設定影響，一律完整顯示 —— 那是要求人立刻處理的內容。
#export AI_TEAM_REPORT_DETAIL=full

# 系統出錯停下時，請 agent 把錯誤紀錄翻成白話（發生什麼、為什麼、影響、可以怎麼做）所用的模型。
# 走 claude-code runtime、不給任何工具；每次停給人呼叫一次，haiku 約 US$0.01～0.03。
# 說明產生不了（逾時、額度用完）時自動改用固定的後備文字，不影響原本的停止流程。
#export AI_TEAM_EXPLAINER_MODEL=haiku
# 設成 false 則一律使用後備文字、不呼叫模型。這是布林設定，不能設成空字串。
#export AI_TEAM_EXPLAINER_ENABLED=true
