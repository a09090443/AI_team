  "roles": {
    "coordinator": {
      "name": "PM Agent",
      "runtime": "claude-code",
      "model": "opus",
      "prompt": "prompts/intake.md",
      "botTokenEnv": "SLACK_BOT_TOKEN_PM",
      "appTokenEnv": "SLACK_APP_TOKEN_PM",
      "tools": [
        "Read",
        "Grep",
        "Glob",
        "WebSearch",
        "WebFetch(domain:repo1.maven.org)",
        "WebFetch(domain:central.sonatype.com)",
        "WebFetch(domain:github.com)",
        "Bash(git status *)",
        "Bash(git log *)",
        "Bash(git show *)",
        "Bash(git diff *)",
        "Bash(git rev-parse *)",
        "Bash(git -C * status *)",
        "Bash(git -C * log *)",
        "Bash(git -C * show *)",
        "Bash(git -C * diff *)",
        "Bash(git -C * rev-parse *)"
      ]
    },
    "architect": {
      "name": "Architecture Agent",
      "runtime": "claude-code",
      "model": "opus",
      "prompt": "prompts/design.md",
      "botTokenEnv": "SLACK_BOT_TOKEN_ARCHITECTURE",
      "appTokenEnv": "SLACK_APP_TOKEN_ARCHITECTURE",
      "tools": [
        "Read",
        "Grep",
        "Glob"
      ]
    },
    "builder": {
      "name": "Backend Agent",
      "runtime": "claude-code",
      "model": "opus",
      "prompt": "prompts/implement.md",
      "botTokenEnv": "SLACK_BOT_TOKEN_BACKEND",
      "appTokenEnv": "SLACK_APP_TOKEN_BACKEND",
      "tools": [
        "Read",
        "Write",
        "Edit",
        "Grep",
        "Glob",
        "Bash(gradle *)",
        "Bash(npm --version)",
        "Bash(node --version)",
        "Bash(npm --prefix bestpartner-ui *)",
        "Bash(npm --prefix docs-site *)",
        "Bash(bash scripts/harness-drift-scan.sh)",
        "Bash(git *)",
        "Bash(ls *)"
      ]
    },
    "tester": {
      "name": "QA Agent",
      "runtime": "codex",
      "model": "gpt-5.6-sol",
      "reasoningEffort": "medium",
      "prompt": "prompts/verify.md",
      "botTokenEnv": "SLACK_BOT_TOKEN_QA",
      "appTokenEnv": "SLACK_APP_TOKEN_QA",
      "tools": [
        "Read",
        "Write",
        "Edit",
        "Grep",
        "Glob",
        "Bash(gradle *)",
        "Bash(npm --prefix bestpartner-ui *)",
        "Bash(bash scripts/harness-drift-scan.sh)",
        "Bash(git *)",
        "Bash(ls *)"
      ]
    },
    "inspector": {
      "name": "Code Reviewer",
      "runtime": "codex",
      "model": "",
      "prompt": "prompts/review.md",
      "botTokenEnv": "SLACK_BOT_TOKEN_CODE_REVIEW",
      "appTokenEnv": "SLACK_APP_TOKEN_CODE_REVIEW",
      "tools": [
        "Read",
        "Grep",
        "Glob",
        "Bash(git diff *)",
        "Bash(git log *)",
        "Bash(git show *)",
        "Bash(git -C * diff *)",
        "Bash(git -C * log *)",
        "Bash(git -C * show *)"
      ]
    },
    "builder_codex": {
      "name": "Backend Agent",
      "runtime": "codex",
      "model": "gpt-5.6-sol",
      "reasoningEffort": "medium",
      "prompt": "prompts/implement.md",
      "botTokenEnv": "SLACK_BOT_TOKEN_BUILDER_CODEX",
      "appTokenEnv": "SLACK_APP_TOKEN_BUILDER_CODEX",
      "tools": [
        "Read",
        "Write",
        "Edit",
        "Grep",
        "Glob",
        "Bash(gradle *)",
        "Bash(npm --prefix bestpartner-ui *)",
        "Bash(git status *)",
        "Bash(git diff *)",
        "Bash(ls *)"
      ]
    }
  },
  "entry": "intake",
  "maxTransitions": 24,
  "nodes": {
    "intake": {
      "kind": "AGENT",
      "role": "coordinator",
      "schema": "schemas/requirements.json",
      "scope": "READ_ONLY",
      "gate": "REQUIREMENTS",
      "workspace": false,
      "writablePaths": [],
      "plan": null,
      "next": "design",
      "blocked": "human",
      "routes": {
        "question": "end",
        "implementation": "design",
        "human": "human"
      },
      "requires": [],
      "maxVisits": 3,
      "timeoutSeconds": 900,
      "maxTurns": 40
    },
    "design": {
      "kind": "AGENT",
      "role": "architect",
      "schema": "schemas/analysis.json",
      "scope": "READ_ONLY",
      "gate": "REPORT",
      "workspace": false,
      "writablePaths": [],
      "plan": null,
      "next": "plan",
      "blocked": "human",
      "routes": {
        "ready": "plan",
        "human": "human"
      },
      "requires": [
        "intake"
      ],
      "maxVisits": 3,
      "timeoutSeconds": 900,
      "maxTurns": 40
    },
    "plan": {
      "instructions": "prompts/plan.md",
      "kind": "AGENT",
      "role": "tester",
      "schema": "schemas/plan.json",
      "scope": "READ_ONLY",
      "gate": "TEST_PLAN",
      "workspace": false,
      "writablePaths": [],
      "plan": null,
      "next": "implementation",
      "blocked": "triage",
      "routes": {},
      "requires": [
        "design"
      ],
      "maxVisits": 3,
      "timeoutSeconds": 900,
      "maxTurns": 40
    },
    "implementation": {
      "kind": "AGENT",
      "role": "builder",
      "schema": "schemas/implementation.json",
      "scope": "WORKSPACE",
      "gate": "IMPLEMENTATION",
      "workspace": true,
      "writablePaths": [],
      "plan": null,
      "next": "verification",
      "blocked": "triage",
      "routes": {},
      "requires": [
        "plan"
      ],
      "maxVisits": 3,
      "timeoutSeconds": 1800,
      "maxTurns": 80,
      "protectedPathFallback": {
        "role": "builder_codex",
        "paths": [
          ".claude/rules/**",
          ".claude/skills/**"
        ]
      }
    },
    "verification": {
      "kind": "AGENT",
      "role": "tester",
      "schema": "schemas/verification.json",
      "scope": "LIMITED",
      "gate": "VERIFICATION",
      "workspace": true,
      "writablePaths": [
        "**/src/test/**",
        "bestpartner-ui/src/**/__tests__/**",
        "bestpartner-service/build/**",
        "bestpartner-service/.gradle/**",
        "bestpartner-service/.kotlin/**",
        "bestpartner-ui/node_modules/**",
        "bestpartner-ui/dist/**"
      ],
      "localTestNetwork": true,
      "plan": "plan",
      "next": "review",
      "blocked": "triage",
      "routes": {},
      "requires": [
        "plan",
        "implementation"
      ],
      "maxVisits": 3,
      "timeoutSeconds": 1800,
      "maxTurns": 60
    },
    "review": {
      "kind": "AGENT",
      "role": "inspector",
      "schema": "schemas/review.json",
      "scope": "READ_ONLY",
      "gate": "REVIEW",
      "workspace": true,
      "writablePaths": [],
      "plan": null,
      "next": "approval",
      "blocked": "triage",
      "routes": {},
      "requires": [
        "verification"
      ],
      "maxVisits": 3,
      "timeoutSeconds": 900,
      "maxTurns": 40
    },
    "triage": {
      "instructions": "prompts/triage.md",
      "kind": "AGENT",
      "role": "coordinator",
      "schema": "schemas/analysis.json",
      "scope": "READ_ONLY",
      "gate": "REPORT",
      "workspace": false,
      "writablePaths": [],
      "plan": null,
      "next": "human",
      "blocked": "human",
      "routes": {
        "implementation": "implementation",
        "verification": "verification",
        "human": "human",
        "requirements": "intake",
        "plan": "plan",
        "design": "design"
      },
      "requires": [],
      "maxVisits": 3,
