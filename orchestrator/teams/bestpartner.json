          "ci",
          "--no-audit",
          "--no-fund"
        ],
        [
          "npm",
          "--prefix",
          "bestpartner-ui",
          "run",
          "build"
        ],
        [
          "npm",
          "--prefix",
          "bestpartner-ui",
          "run",
