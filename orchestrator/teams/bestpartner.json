        ]
      ],
      "timeoutSeconds": 1800,
      "docOnlyPaths": [
        "*.md",
        "docs/**",
        ".claude/**",
        ".agents/**",
        "docs-site/docs/**",
        "docs-site/blog/**"
      ]
    }
