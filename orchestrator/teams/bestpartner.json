          "--tests",
          "tw.zipe.bastpartner.util.CryptoUtilsTest",
          "--tests",
          "tw.zipe.bastpartner.util.ToolSchemaGeneratorSensitiveTest",
          "--tests",
          "tw.zipe.bastpartner.util.ToolSchemaGeneratorTest",
          "--tests",
          "tw.zipe.bastpartner.converter.PasswordEncryptConverterTest",
          "--tests",
          "tw.zipe.bastpartner.converter.SensitiveValueCodecTest",
          "--tests",
          "tw.zipe.bastpartner.converter.WorkflowSecretConverterTest",
          "--tests",
          "tw.zipe.bastpartner.dto.OutputNodeConfigTest",
          "--tests",
          "tw.zipe.bastpartner.dto.workflow.config.NodeConfigTest",
          "--tests",
          "tw.zipe.bastpartner.provider.CompositeToolProviderTest",
          "--tests",
          "tw.zipe.bastpartner.service.workflow.BasicExecutorTest"
        ],
        [
          "gradle",
          "-p",
          "bestpartner-service",
          "--no-daemon",
          "test",
          "--tests",
          "tw.zipe.bastpartner.service.workflow.ConditionExecutorTest",
          "--tests",
          "tw.zipe.bastpartner.service.workflow.DataTransformExecutorTest",
          "--tests",
          "tw.zipe.bastpartner.service.workflow.ExecutionContextTest",
          "--tests",
          "tw.zipe.bastpartner.service.workflow.HttpRequestExecutorTest",
          "--tests",
          "tw.zipe.bastpartner.service.workflow.KnowledgeRagExecutorTest",
          "--tests",
          "tw.zipe.bastpartner.service.workflow.LlmAssistantPromptSourceTest",
          "--tests",
          "tw.zipe.bastpartner.service.workflow.PromptExecutorTest",
          "--tests",
