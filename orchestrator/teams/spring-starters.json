{
  "version": 2,
  "id": "spring-starters",
  "project": {
    "requirePlanApproval": true,
    "autoApprovePlanWhenValid": true,
    "operations": {
      "java-verify": {"nodes": ["implementation"], "directory": ".", "argv": ["mvn", "-B", "verify"], "writes": ["."]},
      "docs-install": {"nodes": ["implementation"], "directory": "doc-site", "argv": ["npm", "ci"], "writes": ["doc-site/node_modules"]},
      "qa-java": {"nodes": ["verification"], "directory": ".", "argv": ["mvn", "-B", "-o", "-pl", "base-spring-boot-starter", "verify"], "writes": ["base-spring-boot-starter/target"]},
      "qa-reactor": {"nodes": ["verification"], "directory": ".", "argv": ["mvn", "-B", "-o", "verify"], "writes": ["target", "base-spring-boot-starter/target", "db-spring-boot-starter/target", "example-keycloak/target", "iam-spring-boot-starter/target", "job-spring-boot-starter/target", "keycloak-spring-boot-starter/target", "logon-spring-boot-starter/target", "starters_example/target", "web-service-spring-boot-starter/target", "web-spring-boot-starter/target"]},
      "qa-docs-dir": {"nodes": ["verification"], "directory": ".", "argv": ["mkdir", "-p", "target/qa-docs"], "writes": ["target"]},
      "qa-docs-snapshot": {"nodes": ["verification"], "directory": ".", "argv": ["git", "archive", "--output=target/qa-docs/snapshot.tar", "HEAD", "doc-site", "llms.txt", "llms-full.txt"], "writes": ["target"]},
      "qa-docs-extract": {"nodes": ["verification"], "directory": ".", "argv": ["tar", "-x", "-f", "target/qa-docs/snapshot.tar", "-C", "target/qa-docs"], "writes": ["target"]},
      "qa-docs-install": {"nodes": ["verification"], "directory": ".", "argv": ["npm", "--prefix", "target/qa-docs/doc-site", "ci", "--offline", "--ignore-scripts", "--no-audit", "--no-fund"], "writes": ["target"]},
      "qa-docs-build": {"nodes": ["verification"], "directory": ".", "argv": ["npm", "--prefix", "target/qa-docs/doc-site", "run", "build"], "writes": ["target"]},
      "qa-docs-compare-llms": {"nodes": ["verification"], "directory": ".", "argv": ["git", "diff", "--no-index", "--exit-code", "target/qa-docs/doc-site/build/llms.txt", "llms.txt"], "writes": []},
      "qa-docs-compare-llms-full": {"nodes": ["verification"], "directory": ".", "argv": ["git", "diff", "--no-index", "--exit-code", "target/qa-docs/doc-site/build/llms-full.txt", "llms-full.txt"], "writes": []},
      "docs-build": {"nodes": ["implementation"], "directory": "doc-site", "argv": ["npm", "run", "build"], "writes": ["doc-site/build", "doc-site/.docusaurus", "llms.txt", "llms-full.txt"]}
    },
    "requiredTools": [
      "java",
      "mvn",
      "node",
      "npm",
      "git",
      "tar",
      "mkdir"
    ],
    "name": "zipe-spring-boot-starters",
    "repositoryEnv": "AI_TEAM_REPO",
    "baseBranch": "develop",
    "buildInstructions": "依 AGENTS.md 與專案 skills；mvn -B verify。需生成的文件必須依規定產生，未完成不能宣稱通過。文件建置請在 doc-site 目錄執行 npm ci（有 lockfile）或 npm install（無 lockfile），再執行 npm run build；使用 PATH 上的 npm，不使用 npx 或絕對路徑替代。",
    "testInstructions": "先制定情境測試計畫，再驗收；不得只看程式或單元測試數量。QA localTestNetwork 僅開放隔離 namespace 內本機測試，不連外。Maven 使用 -o。文件在隔離產物副本建置與比對，依序使用操作 qa-docs-dir、qa-docs-snapshot、qa-docs-extract、qa-docs-install、qa-docs-build，再以 qa-docs-compare-llms 與 qa-docs-compare-llms-full 比對副本建置出的 llms 產物與根目錄提交的版本（結束碼 0 表示一致）。不要在原 doc-site 執行 npm ci/build。快取不足須回報，不得下載或繞過沙箱；根目錄 llms.txt/llms-full.txt 與原始文件保持唯讀。",
    "protectedPaths": [
      "**/src/main/**",
      "**/pom.xml"
    ],
    "cachePaths": [
      ".m2/repository",
      ".npm"
    ],
    "verification": {
      "commands": [
        [
          "mvn",
          "-B",
          "clean",
          "verify"
        ]
      ],
      "timeoutSeconds": 1800
    }
  },
  "roles": {
    "coordinator": {
      "name": "PM Agent",
      "runtime": "claude-code",
      "model": "opus",
      "prompt": "prompts/intake.md",
      "botTokenEnv": "SLACK_BOT_TOKEN_PM",
      "appTokenEnv": "SLACK_APP_TOKEN_PM",
      "tools": [
        "Read",
        "Grep",
        "Glob",
        "WebSearch",
        "WebFetch(domain:repo1.maven.org)",
        "WebFetch(domain:central.sonatype.com)",
        "WebFetch(domain:github.com)",
        "Bash(git status *)",
        "Bash(git log *)",
        "Bash(git show *)",
        "Bash(git diff *)",
        "Bash(git rev-parse *)",
        "Bash(git -C * status *)",
        "Bash(git -C * log *)",
        "Bash(git -C * show *)",
        "Bash(git -C * diff *)",
        "Bash(git -C * rev-parse *)"
      ]
    },
    "architect": {
      "name": "Architecture Agent",
      "runtime": "claude-code",
      "model": "opus",
      "prompt": "prompts/design.md",
      "botTokenEnv": "SLACK_BOT_TOKEN_ARCHITECTURE",
      "appTokenEnv": "SLACK_APP_TOKEN_ARCHITECTURE",
      "tools": [
        "Read",
        "Grep",
        "Glob"
      ]
    },
    "builder": {
      "name": "Backend Agent",
      "runtime": "claude-code",
      "model": "opus",
      "prompt": "prompts/implement.md",
      "botTokenEnv": "SLACK_BOT_TOKEN_BACKEND",
      "appTokenEnv": "SLACK_APP_TOKEN_BACKEND",
      "tools": [
        "Read",
        "Write",
        "Edit",
        "Grep",
        "Glob",
        "Bash(npm --version)",
        "Bash(npm -v)",
        "Bash(node --version)",
        "Bash(npm ci)",
        "Bash(npm install)",
        "Bash(npm run build)",
        "Bash(mvn *)",
        "Bash(git *)",
        "Bash(ls *)"
      ]
    },
    "tester": {
      "name": "QA Agent",
      "runtime": "codex",
      "model": "gpt-5.6-sol",
      "reasoningEffort": "medium",
      "prompt": "prompts/verify.md",
      "botTokenEnv": "SLACK_BOT_TOKEN_QA",
      "appTokenEnv": "SLACK_APP_TOKEN_QA",
      "tools": [
        "Read",
        "Write",
        "Edit",
        "Grep",
        "Glob",
        "Bash(mvn *)",
        "Bash(git *)",
        "Bash(ls *)"
      ]
    },
    "inspector": {
      "name": "Code Reviewer",
      "runtime": "codex",
      "model": "",
      "prompt": "prompts/review.md",
      "botTokenEnv": "SLACK_BOT_TOKEN_CODE_REVIEW",
      "appTokenEnv": "SLACK_APP_TOKEN_CODE_REVIEW",
      "tools": [
        "Read",
        "Grep",
        "Glob",
        "Bash(git diff *)",
        "Bash(git log *)",
        "Bash(git show *)",
        "Bash(git -C * diff *)",
        "Bash(git -C * log *)",
        "Bash(git -C * show *)"
      ]
    }
  },
  "entry": "intake",
  "maxTransitions": 24,
  "nodes": {
    "intake": {
      "kind": "AGENT",
      "role": "coordinator",
      "schema": "schemas/requirements.json",
      "scope": "READ_ONLY",
      "gate": "REQUIREMENTS",
      "workspace": false,
      "writablePaths": [],
      "plan": null,
      "next": "design",
      "blocked": "human",
      "routes": {
        "question": "end",
        "implementation": "design",
        "human": "human"
      },
      "requires": [],
      "maxVisits": 3,
      "timeoutSeconds": 900,
      "maxTurns": 40
    },
    "design": {
      "kind": "AGENT",
      "role": "architect",
      "schema": "schemas/analysis.json",
      "scope": "READ_ONLY",
      "gate": "REPORT",
      "workspace": false,
      "writablePaths": [],
      "plan": null,
      "next": "plan",
      "blocked": "human",
      "routes": {
        "ready": "plan",
        "human": "human"
      },
      "requires": [
        "intake"
      ],
      "maxVisits": 3,
      "timeoutSeconds": 900,
      "maxTurns": 40
    },
    "plan": {
      "instructions": "prompts/plan.md",
      "kind": "AGENT",
      "role": "tester",
      "schema": "schemas/plan.json",
      "scope": "READ_ONLY",
      "gate": "TEST_PLAN",
      "workspace": false,
      "writablePaths": [],
      "plan": null,
      "next": "implementation",
      "blocked": "triage",
      "routes": {},
      "requires": [
        "design"
      ],
      "maxVisits": 3,
      "timeoutSeconds": 900,
      "maxTurns": 40
    },
    "implementation": {
      "kind": "AGENT",
      "role": "builder",
      "schema": "schemas/implementation.json",
      "scope": "WORKSPACE",
      "gate": "IMPLEMENTATION",
      "workspace": true,
      "writablePaths": [],
      "plan": null,
      "next": "verification",
      "blocked": "triage",
      "routes": {},
      "requires": [
        "plan"
      ],
      "maxVisits": 3,
      "timeoutSeconds": 1800,
      "maxTurns": 80
    },
    "verification": {
      "kind": "AGENT",
      "role": "tester",
      "schema": "schemas/verification.json",
      "scope": "LIMITED",
      "gate": "VERIFICATION",
      "workspace": true,
      "writablePaths": [
        "**/src/test/**",
        "**/target/**",
        "base-spring-boot-starter/target/**",
        "db-spring-boot-starter/target/**",
        "example-keycloak/target/**",
        "iam-spring-boot-starter/target/**",
        "job-spring-boot-starter/target/**",
        "keycloak-spring-boot-starter/target/**",
        "logon-spring-boot-starter/target/**",
        "starters_example/target/**",
        "web-service-spring-boot-starter/target/**",
        "web-spring-boot-starter/target/**",
        "target/**"
      ],
      "localTestNetwork": true,
      "plan": "plan",
      "next": "review",
      "blocked": "triage",
      "routes": {},
      "requires": [
        "plan",
        "implementation"
      ],
      "maxVisits": 3,
      "timeoutSeconds": 1800,
      "maxTurns": 60
    },
    "review": {
      "kind": "AGENT",
      "role": "inspector",
      "schema": "schemas/review.json",
      "scope": "READ_ONLY",
      "gate": "REVIEW",
      "workspace": true,
      "writablePaths": [],
      "plan": null,
      "next": "approval",
      "blocked": "triage",
      "routes": {},
      "requires": [
        "verification"
      ],
      "maxVisits": 3,
      "timeoutSeconds": 900,
      "maxTurns": 40
    },
    "triage": {
      "instructions": "prompts/triage.md",
      "kind": "AGENT",
      "role": "coordinator",
      "schema": "schemas/analysis.json",
      "scope": "READ_ONLY",
      "gate": "REPORT",
      "workspace": false,
      "writablePaths": [],
      "plan": null,
      "next": "human",
      "blocked": "human",
      "routes": {
        "implementation": "implementation",
        "verification": "verification",
        "human": "human",
        "requirements": "intake",
        "plan": "plan",
        "design": "design"
      },
      "requires": [],
      "maxVisits": 3,
      "timeoutSeconds": 900,
      "maxTurns": 40
    },
    "approval": {
      "kind": "APPROVAL",
      "requires": [
        "intake",
        "implementation",
        "plan",
        "verification",
        "review",
        "design"
      ]
    }
  }
}
