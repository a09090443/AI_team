{
  "version": 2,
  "id": "dynamic-api",
  "project": {
    "requirePlanApproval": true,
    "autoApprovePlanWhenValid": true,
    "operations": {
      "backend-compile": {
        "nodes": [
          "implementation"
        ],
        "directory": ".",
        "argv": [
          "gradle",
          "-p",
          "backend",
          "--no-daemon",
          "compileJava",
          "compileTestJava",
          "-x",
          "buildFrontend"
        ],
        "writes": [
          "backend/build",
          "backend/.gradle"
        ]
      },
      "backend-test": {
        "nodes": [
          "implementation"
        ],
        "directory": ".",
        "argv": [
          "gradle",
          "-p",
          "backend",
          "--no-daemon",
          "test",
          "-x",
          "buildFrontend"
        ],
        "writes": [
          "backend/build",
          "backend/.gradle"
        ]
      },
      "ui-install": {
        "nodes": [
          "implementation"
        ],
        "directory": ".",
        "argv": [
          "npm",
          "--prefix",
          "nextjs-dynamic-api-manager",
          "ci"
        ],
        "writes": [
          "nextjs-dynamic-api-manager/node_modules",
          "nextjs-dynamic-api-manager/.next",
          "nextjs-dynamic-api-manager/out"
        ]
      },
      "ui-type-check": {
        "nodes": [
          "implementation"
        ],
        "directory": ".",
        "argv": [
          "npm",
          "--prefix",
          "nextjs-dynamic-api-manager",
          "run",
          "type-check"
        ],
        "writes": [
          "nextjs-dynamic-api-manager/node_modules",
          "nextjs-dynamic-api-manager/.next",
          "nextjs-dynamic-api-manager/out"
        ]
      },
      "ui-lint": {
        "nodes": [
          "implementation"
        ],
        "directory": ".",
        "argv": [
          "npm",
          "--prefix",
          "nextjs-dynamic-api-manager",
          "run",
          "lint"
        ],
        "writes": [
          "nextjs-dynamic-api-manager/node_modules",
          "nextjs-dynamic-api-manager/.next",
          "nextjs-dynamic-api-manager/out"
        ]
      },
      "ui-build": {
        "nodes": [
          "implementation"
        ],
        "directory": ".",
        "argv": [
          "npm",
          "--prefix",
          "nextjs-dynamic-api-manager",
          "run",
          "build"
        ],
        "writes": [
          "nextjs-dynamic-api-manager/node_modules",
          "nextjs-dynamic-api-manager/.next",
          "nextjs-dynamic-api-manager/out"
        ]
      },
      "docs-install": {
        "nodes": [
          "implementation"
        ],
        "directory": ".",
        "argv": [
          "npm",
          "--prefix",
          "docs-site",
          "ci"
        ],
        "writes": [
          "docs-site/node_modules"
        ]
      },
      "docs-build": {
        "nodes": [
          "implementation"
        ],
        "directory": ".",
        "argv": [
          "npm",
          "--prefix",
          "docs-site",
          "run",
          "build"
        ],
        "writes": [
          "docs-site/build",
          "docs-site/.docusaurus",
          "docs-site/node_modules"
        ]
      },
      "qa-backend-test": {
        "nodes": [
          "verification"
        ],
        "directory": ".",
        "argv": [
          "gradle",
          "-p",
          "backend",
          "--offline",
          "--no-daemon",
          "test",
          "-x",
          "buildFrontend"
        ],
        "writes": [
          "backend/build",
          "backend/.gradle"
        ]
      },
      "qa-ui-install": {
        "nodes": [
          "verification"
        ],
        "directory": ".",
        "argv": [
          "npm",
          "--prefix",
          "nextjs-dynamic-api-manager",
          "ci",
          "--offline",
          "--no-audit",
          "--no-fund"
        ],
        "writes": [
          "nextjs-dynamic-api-manager/node_modules",
          "nextjs-dynamic-api-manager/.next",
          "nextjs-dynamic-api-manager/out"
        ]
      },
      "qa-ui-type-check": {
        "nodes": [
          "verification"
        ],
        "directory": ".",
        "argv": [
          "npm",
          "--prefix",
          "nextjs-dynamic-api-manager",
          "run",
          "type-check"
        ],
        "writes": [
          "nextjs-dynamic-api-manager/node_modules",
          "nextjs-dynamic-api-manager/.next",
          "nextjs-dynamic-api-manager/out"
        ]
      },
      "qa-ui-lint": {
        "nodes": [
          "verification"
        ],
        "directory": ".",
        "argv": [
          "npm",
          "--prefix",
          "nextjs-dynamic-api-manager",
          "run",
          "lint"
        ],
        "writes": [
          "nextjs-dynamic-api-manager/node_modules",
          "nextjs-dynamic-api-manager/.next",
          "nextjs-dynamic-api-manager/out"
        ]
      },
      "qa-ui-build": {
        "nodes": [
          "verification"
        ],
        "directory": ".",
        "argv": [
          "npm",
          "--prefix",
          "nextjs-dynamic-api-manager",
          "run",
          "build"
        ],
        "writes": [
          "nextjs-dynamic-api-manager/node_modules",
          "nextjs-dynamic-api-manager/.next",
          "nextjs-dynamic-api-manager/out"
        ]
      },
      "qa-docs-dir": {
        "nodes": [
          "verification"
        ],
        "directory": ".",
        "argv": [
          "mkdir",
          "-p",
          "target/qa-docs"
        ],
        "writes": [
          "target/qa-docs"
        ]
      },
      "qa-docs-snapshot": {
        "nodes": [
          "verification"
        ],
        "directory": ".",
        "argv": [
          "git",
          "archive",
          "--output=target/qa-docs/snapshot.tar",
          "HEAD",
          "docs-site"
        ],
        "writes": [
          "target/qa-docs"
        ]
      },
      "qa-docs-extract": {
        "nodes": [
          "verification"
        ],
        "directory": ".",
        "argv": [
          "tar",
          "-x",
          "-f",
          "target/qa-docs/snapshot.tar",
          "-C",
          "target/qa-docs"
        ],
        "writes": [
          "target/qa-docs"
        ]
      },
      "qa-docs-install": {
        "nodes": [
          "verification"
        ],
        "directory": ".",
        "argv": [
          "npm",
          "--prefix",
          "target/qa-docs/docs-site",
          "ci",
          "--offline",
          "--ignore-scripts",
          "--no-audit",
          "--no-fund"
        ],
        "writes": [
          "target/qa-docs"
        ]
      },
      "qa-docs-build": {
        "nodes": [
          "verification"
        ],
        "directory": ".",
        "argv": [
          "npm",
          "--prefix",
          "target/qa-docs/docs-site",
          "run",
          "build"
        ],
        "writes": [
          "target/qa-docs"
        ]
      },
      "qa-docs-clean": {
        "nodes": [
          "verification"
        ],
        "directory": ".",
        "argv": [
          "find",
          "target/qa-docs",
          "-mindepth",
          "1",
          "-delete"
        ],
        "writes": [
          "target/qa-docs"
        ]
      }
    },
    "requiredTools": [
      "java",
      "gradle",
      "node",
      "npm",
      "git",
      "tar",
      "mkdir",
      "find"
    ],
    "name": "dynamic-api",
    "repositoryEnv": "AI_TEAM_REPO",
    "baseBranch": "master",
    "buildInstructions": "依 repo 的 AGENTS.md 與 .claude/rules/（單一事實來源）；套件名是 com.dynamicapi。後端用 PATH 上的 gradle（repo 的 gradlew 是 8.7，VM 共用 8.14.5），一律 -p backend --no-daemon，使用已宣告的 backend-* 操作。backend/build.gradle 的前端建置任務寫死 Windows 版 tools/node-*-win-x64/npm.cmd，在 VM 上一定失敗，所以會觸發 processResources 的任務（compileTestJava、test、bootJar、bootRun）都必須加 -x buildFrontend；不得修改 build.gradle 或 tools/ 來繞過。前端以 npm --prefix nextjs-dynamic-api-manager ci／run type-check／run lint／run build；文件以 npm --prefix docs-site ci／run build。frontend/（舊 Angular）與 tools/ 不要修改。新增前端頁面要同步 build.gradle 的 copyNextjsBuild 頁面清單與 SpaController；資料表變更只能新增 db.migration 腳本，不改既有腳本。不使用 pwsh、npx 或絕對路徑替代。",
    "testInstructions": "先制定情境測試計畫，再驗收；不得只看單元測試數量。後端只有少量測試（ResponseRepositoryTest、DynamicControllerServiceTest）：實作以 backend-test、驗收以 qa-backend-test 執行，系統獨立驗證也會在全新 clone 執行同一個測試指令，結束碼必須為 0 才會進入驗收、審查與發布，任何角色或真人都不能把失敗改記為無法核實後放行。已知問題：正式設定 data-source.properties 的 SQLite 路徑是 Windows 的 D:/tmp，repo 還沒有測試專用設定時，這兩個測試在 Linux 必定失敗；實作遇到時要回報受阻（BLOCKED、verify_passed=false）並附原始錯誤，不得寫成成功。不得修改正式設定、關閉或刪除測試；只有需求明確授權時，才可新增只在測試時生效的設定（例如 backend/src/test/resources）。動態載入（上傳 JAR、啟用 Endpoint／RESTful、Mock 命中）需要啟動服務並以範例 JAR 手動驗證，VM 沙箱內無法完成時標為「無法核實」，不得宣稱通過。前端依序 qa-ui-install、qa-ui-type-check、qa-ui-lint、qa-ui-build。實作階段可以連網下載依賴，backend-*、ui-install 等實作操作會把套件寫進共用快取（Gradle 為 GRADLE_USER_HOME，npm 為 ~/.npm）。QA 的 localTestNetwork 沙箱不連外，所以 qa-* 操作以 --offline 使用同一份快取；快取缺件時判定為實作階段尚未執行對應建置，退回實作補跑，不得繞過沙箱。純文字變更只核對內容及必要一致性，不無條件執行後端／前端回歸。文件站依序 qa-docs-dir、qa-docs-clean、qa-docs-snapshot、qa-docs-extract、qa-docs-install、qa-docs-build，在 target/qa-docs 副本驗證最終 HEAD；實作先執行 docs-install／docs-build 準備快取。原 docs-site 唯讀。",
    "protectedPaths": [
      "backend/src/main/**",
      "base-jar/src/**",
      "**/build.gradle",
      "**/settings.gradle",
      "**/package.json",
      "**/package-lock.json"
    ],
    "cachePaths": [
      ".cache/gradle",
      ".npm"
    ],
    "verification": {
      "commands": [
        [
          "gradle",
          "-p",
          "backend",
          "--no-daemon",
          "test",
          "-x",
          "buildFrontend"
        ],
        [
          "npm",
          "--prefix",
          "nextjs-dynamic-api-manager",
          "ci",
          "--no-audit",
          "--no-fund"
        ],
        [
          "npm",
          "--prefix",
          "nextjs-dynamic-api-manager",
          "run",
          "type-check"
        ],
        [
          "npm",
          "--prefix",
          "nextjs-dynamic-api-manager",
          "run",
          "build"
        ]
      ],
      "timeoutSeconds": 1800,
      "docOnlyPaths": [
        "*.md",
        "docs/**",
        ".claude/**",
        ".agents/**",
        "docs-site/docs/**",
        "docs-site/blog/**"
      ]
    }
  },
  "roles": {
    "coordinator": {
      "name": "PM Agent",
      "runtime": "claude-code",
      "model": "opus",
      "prompt": "prompts/intake.md",
      "botTokenEnv": "SLACK_BOT_TOKEN_PM",
      "appTokenEnv": "SLACK_APP_TOKEN_PM",
      "tools": [
        "Read",
        "Grep",
        "Glob",
        "WebSearch",
        "WebFetch(domain:repo1.maven.org)",
        "WebFetch(domain:central.sonatype.com)",
        "WebFetch(domain:github.com)",
        "Bash(git status *)",
        "Bash(git log *)",
        "Bash(git show *)",
        "Bash(git diff *)",
        "Bash(git rev-parse *)",
        "Bash(git -C * status *)",
        "Bash(git -C * log *)",
        "Bash(git -C * show *)",
        "Bash(git -C * diff *)",
        "Bash(git -C * rev-parse *)"
      ]
    },
    "architect": {
      "name": "Architecture Agent",
      "runtime": "claude-code",
      "model": "opus",
      "prompt": "prompts/design.md",
      "botTokenEnv": "SLACK_BOT_TOKEN_ARCHITECTURE",
      "appTokenEnv": "SLACK_APP_TOKEN_ARCHITECTURE",
      "tools": [
        "Read",
        "Grep",
        "Glob"
      ],
      "capabilities": "應用架構、API、資料模型、相依方向與相容性設計；唯讀分析。 純文字文件僅確認來源、修改範圍及同步關係。"
    },
    "builder": {
      "name": "Backend Agent",
      "runtime": "claude-code",
      "model": "opus",
      "prompt": "prompts/implement.md",
      "botTokenEnv": "SLACK_BOT_TOKEN_BACKEND",
      "appTokenEnv": "SLACK_APP_TOKEN_BACKEND",
      "tools": [
        "Read",
        "Write",
        "Edit",
        "Grep",
        "Glob",
        "Bash(gradle *)",
        "Bash(npm --version)",
        "Bash(node --version)",
        "Bash(npm --prefix nextjs-dynamic-api-manager *)",
        "Bash(npm --prefix docs-site *)",
        "Bash(git *)",
        "Bash(ls *)"
      ],
      "capabilities": "應用程式、前後端功能與測試實作；可在工作區修改程式與設定，依契約建置測試；Claude 受保護路徑另走分段改派。 文件內容維護、使用者與 agent 文件同步、文件網站建置；純文件修正優先由此角色承接。"
    },
    "tester": {
      "name": "QA Agent",
      "capabilities": "測試計畫、反例設計與驗收：依需求與固定操作判斷要測哪些情境、如何驗證、證據是否足夠；熟悉本專案的驗收操作與文件站隔離建置。",
      "runtime": "codex",
      "model": "gpt-5.6-sol",
      "reasoningEffort": "medium",
      "prompt": "prompts/verify.md",
      "botTokenEnv": "SLACK_BOT_TOKEN_QA",
      "appTokenEnv": "SLACK_APP_TOKEN_QA",
      "tools": [
        "Read",
        "Write",
        "Edit",
        "Grep",
        "Glob",
        "Bash(gradle *)",
        "Bash(npm --prefix nextjs-dynamic-api-manager *)",
        "Bash(git *)",
        "Bash(ls *)",
        "Bash(mkdir -p target/qa-docs)",
        "Bash(git archive *)",
        "Bash(tar -x -f target/qa-docs/snapshot.tar -C target/qa-docs)",
        "Bash(npm --prefix target/qa-docs/docs-site *)",
        "Bash(find target/qa-docs -mindepth 1 -delete)"
      ]
    },
    "infrastructure": {
      "name": "Infrastructure Agent",
      "runtime": "codex",
      "model": "gpt-5.6-sol",
      "reasoningEffort": "medium",
      "prompt": "prompts/infrastructure.md",
      "botTokenEnv": "SLACK_BOT_TOKEN_INFRASTRUCTURE",
      "appTokenEnv": "SLACK_APP_TOKEN_INFRASTRUCTURE",
      "tools": [
        "Read",
        "Write",
        "Edit",
        "Grep",
        "Glob",
        "Bash(gradle *)",
        "Bash(npm --prefix nextjs-dynamic-api-manager *)",
        "Bash(git status *)",
        "Bash(git diff *)",
        "Bash(git log *)",
        "Bash(git show *)",
        "Bash(ls *)"
      ],
      "capabilities": "測試／SIT 環境、容器、部署設定與可用性檢查；開發階段依既有工作區契約實作。本專案未設定服務建置目標與主機操作，不得宣稱已部署。"
    },
    "inspector": {
      "name": "Code Reviewer",
      "runtime": "codex",
      "model": "",
      "prompt": "prompts/review.md",
      "botTokenEnv": "SLACK_BOT_TOKEN_CODE_REVIEW",
      "appTokenEnv": "SLACK_APP_TOKEN_CODE_REVIEW",
      "tools": [
        "Read",
        "Grep",
        "Glob",
        "Bash(git diff *)",
        "Bash(git log *)",
        "Bash(git show *)",
        "Bash(git -C * diff *)",
        "Bash(git -C * log *)",
        "Bash(git -C * show *)"
      ]
    },
    "builder_codex": {
      "name": "Backend Agent",
      "runtime": "codex",
      "model": "gpt-5.6-sol",
      "reasoningEffort": "medium",
      "prompt": "prompts/implement.md",
      "botTokenEnv": "SLACK_BOT_TOKEN_BUILDER_CODEX",
      "appTokenEnv": "SLACK_APP_TOKEN_BUILDER_CODEX",
      "tools": [
        "Read",
        "Write",
        "Edit",
        "Grep",
        "Glob",
        "Bash(gradle *)",
        "Bash(npm --prefix nextjs-dynamic-api-manager *)",
        "Bash(git status *)",
        "Bash(git diff *)",
        "Bash(ls *)"
      ]
    }
  },
  "entry": "intake",
  "maxTransitions": 24,
  "nodes": {
    "intake": {
      "kind": "AGENT",
      "role": "coordinator",
      "schema": "schemas/requirements.json",
      "scope": "READ_ONLY",
      "gate": "REQUIREMENTS",
      "workspace": false,
      "writablePaths": [],
      "plan": null,
      "next": "design",
      "blocked": "human",
      "routes": {
        "question": "end",
        "implementation": "design",
        "human": "human"
      },
      "requires": [],
      "maxVisits": 3,
      "timeoutSeconds": 900,
      "maxTurns": 40
    },
    "design": {
      "kind": "AGENT",
      "role": "architect",
      "schema": "schemas/analysis.json",
      "scope": "READ_ONLY",
      "gate": "REPORT",
      "workspace": false,
      "writablePaths": [],
      "plan": null,
      "next": "plan",
      "blocked": "triage",
      "routes": {
        "ready": "plan",
        "human": "human"
      },
      "requires": [
        "intake"
      ],
      "maxVisits": 3,
      "timeoutSeconds": 900,
      "maxTurns": 40,
      "candidateRoles": [
        "architect",
        "infrastructure"
      ],
      "instructions": "prompts/design.md"
    },
    "plan": {
      "instructions": "prompts/plan.md",
      "kind": "AGENT",
      "role": "tester",
      "schema": "schemas/plan.json",
      "scope": "READ_ONLY",
      "gate": "TEST_PLAN",
      "workspace": false,
      "writablePaths": [],
      "plan": null,
      "next": "implementation",
      "blocked": "triage",
      "routes": {},
      "requires": [
        "design"
      ],
      "maxVisits": 3,
      "timeoutSeconds": 900,
      "maxTurns": 40
    },
    "implementation": {
      "kind": "AGENT",
      "role": "builder",
      "schema": "schemas/implementation.json",
      "scope": "WORKSPACE",
      "gate": "IMPLEMENTATION",
      "workspace": true,
      "writablePaths": [],
      "plan": null,
      "next": "verification",
      "blocked": "triage",
      "routes": {},
      "requires": [
        "plan"
      ],
      "maxVisits": 3,
      "timeoutSeconds": 1800,
      "maxTurns": 80,
      "protectedPathFallback": {
        "role": "builder_codex",
        "paths": [
          ".claude/rules/**",
          ".claude/skills/**"
        ]
      },
      "candidateRoles": [
        "builder",
        "infrastructure"
      ],
      "instructions": "prompts/implement.md"
    },
    "verification": {
      "kind": "AGENT",
      "role": "tester",
      "schema": "schemas/verification.json",
      "scope": "LIMITED",
      "gate": "VERIFICATION",
      "workspace": true,
      "writablePaths": [
        "**/src/test/**",
        "backend/build/**",
        "backend/.gradle/**",
        "nextjs-dynamic-api-manager/node_modules/**",
        "nextjs-dynamic-api-manager/.next/**",
        "nextjs-dynamic-api-manager/out/**",
        "target/qa-docs/**"
      ],
      "localTestNetwork": true,
      "plan": "plan",
      "next": "review",
      "blocked": "triage",
      "routes": {},
      "requires": [
        "plan",
        "implementation"
      ],
      "maxVisits": 3,
      "timeoutSeconds": 1800,
      "maxTurns": 60
    },
    "review": {
      "kind": "AGENT",
      "role": "inspector",
      "schema": "schemas/review.json",
      "scope": "READ_ONLY",
      "gate": "REVIEW",
      "workspace": true,
      "writablePaths": [],
      "plan": null,
      "next": "approval",
      "blocked": "triage",
      "routes": {},
      "requires": [
        "verification"
      ],
      "maxVisits": 3,
      "timeoutSeconds": 900,
      "maxTurns": 40
    },
    "triage": {
      "instructions": "prompts/triage.md",
      "kind": "AGENT",
      "role": "coordinator",
      "schema": "schemas/analysis.json",
      "scope": "READ_ONLY",
      "gate": "REPORT",
      "workspace": false,
      "writablePaths": [],
      "plan": null,
      "next": "human",
      "blocked": "human",
      "routes": {
        "implementation": "implementation",
        "verification": "verification",
        "human": "human",
        "requirements": "intake",
        "plan": "plan",
        "design": "design"
      },
      "requires": [],
      "maxVisits": 3,
      "timeoutSeconds": 900,
      "maxTurns": 40
    },
    "approval": {
      "kind": "APPROVAL",
      "requires": [
        "intake",
        "implementation",
        "plan",
        "verification",
        "review",
        "design"
      ]
    }
  }
}
