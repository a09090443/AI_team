      "kind": "AGENT",
      "role": "coordinator",
      "schema": "schemas/requirements.json",
      "scope": "READ_ONLY",
      "gate": "REQUIREMENTS",
      "workspace": false,
      "writablePaths": [],
      "plan": null,
      "next": "design",
      "blocked": "human",
      "routes": {
        "question": "end",
        "implementation": "design",
        "light": "plan",
        "human": "human",
        "service": "service"
      },
      "requires": [],
      "maxVisits": 3,
      "timeoutSeconds": 900,
      "maxTurns": 40
    },
    "design": {
      "kind": "AGENT",
      "consultRoles": [
        "builder",
        "tester"
      ],
      "role": "architect",
      "schema": "schemas/analysis.json",
      "scope": "READ_ONLY",
      "gate": "REPORT",
      "workspace": false,
      "writablePaths": [],
      "plan": null,
      "next": "plan",
      "blocked": "triage",
      "routes": {
        "ready": "plan",
        "human": "human"
      },
      "requires": [
        "intake"
      ],
      "maxVisits": 3,
