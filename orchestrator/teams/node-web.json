{
  "version": 2,
  "id": "node-web",
  "project": {
    "requirePlanApproval": true,
    "serviceTarget": null,
    "operations": {
      "install": {"nodes": ["implementation", "frontend", "verification"], "directory": ".", "argv": ["npm", "ci"], "writes": ["node_modules"]},
      "build": {"nodes": ["implementation", "frontend", "verification"], "directory": ".", "argv": ["npm", "run", "build"], "writes": ["dist"]},
      "test": {"nodes": ["implementation", "frontend", "verification"], "directory": ".", "argv": ["npm", "test"], "writes": ["coverage"]},
      "service-prepare": {"nodes": ["service", "deploy"], "directory": ".", "argv": ["python3", "${teams}/skills/service-build/scripts/client.py", "prepare"], "writes": ["ai-team-sandbox/.agent-service"]},
      "service-start": {"nodes": ["service", "deploy"], "directory": ".", "argv": ["python3", "${teams}/skills/service-build/scripts/client.py", "exec", "ai-team-sandbox/start.sh"], "writes": ["ai-team-sandbox/.agent-service"]},
      "service-health": {"nodes": ["service", "deploy"], "directory": ".", "argv": ["python3", "${teams}/skills/service-build/scripts/client.py", "exec", "ai-team-sandbox/health.sh"], "writes": ["ai-team-sandbox/.agent-service"]},
      "service-diagnose": {"nodes": ["service", "deploy"], "directory": ".", "argv": ["python3", "${teams}/skills/service-build/scripts/client.py", "exec", "ai-team-sandbox/diagnose.sh"], "writes": ["ai-team-sandbox/.agent-service"]}
    },
    "requiredTools": [
      "python3",
      "node",
      "npm",
      "git"
    ],
    "name": "Node Web 專案",
    "repositoryEnv": "AI_TEAM_NODE_REPO",
    "baseBranch": "main",
    "buildInstructions": "使用 repo 自己的 AGENTS.md 與 lockfile；依規範安裝依賴並執行 npm run build。",
    "testInstructions": "依專案規範執行 npm test，並逐條對照情境測試計畫。",
    "protectedPaths": [
      "src/**",
      "package.json",
      "package-lock.json"
    ],
    "cachePaths": [
      ".npm"
    ],
    "verification": {
      "commands": [
        [
          "npm",
          "ci"
        ],
        [
          "npm",
          "test"
        ],
        [
          "npm",
          "run",
          "build"
        ]
      ],
      "timeoutSeconds": 1800,
      "docOnlyPaths": ["*.md", "docs/**/*.md", "docs/**/*.mdx"]
    }
  },
  "roles": {
    "coordinator": {
      "name": "PM Agent",
      "runtime": "claude-code",
      "model": "opus",
      "prompt": "prompts/intake.md",
      "botTokenEnv": "SLACK_BOT_TOKEN_PM",
      "appTokenEnv": "SLACK_APP_TOKEN_PM",
      "tools": [
        "Read",
        "Grep",
        "Glob",
        "Bash(git status *)",
        "Bash(git log *)",
        "Bash(git show *)",
        "Bash(git diff *)",
        "Bash(git rev-parse *)",
        "Bash(git -C * status *)",
        "Bash(git -C * log *)",
        "Bash(git -C * show *)",
        "Bash(git -C * diff *)",
        "Bash(git -C * rev-parse *)"
      ]
    },
    "builder": {
      "name": "Backend Agent",
      "runtime": "claude-code",
      "model": "opus",
      "prompt": "prompts/implement.md",
      "botTokenEnv": "SLACK_BOT_TOKEN_BACKEND",
      "appTokenEnv": "SLACK_APP_TOKEN_BACKEND",
      "tools": [
        "Read",
        "Write",
        "Edit",
        "Grep",
        "Glob",
        "Bash(npm *)",
        "Bash(git *)",
        "Bash(ls *)"
      ]
    },
    "tester": {
      "name": "QA Agent",
      "runtime": "claude-code",
      "model": "sonnet",
      "prompt": "prompts/verify.md",
      "botTokenEnv": "SLACK_BOT_TOKEN_QA",
      "appTokenEnv": "SLACK_APP_TOKEN_QA",
      "tools": [
        "Read",
        "Write",
        "Edit",
        "Grep",
        "Glob",
        "Bash(npm *)",
        "Bash(git *)",
        "Bash(ls *)"
      ]
    },
    "security_auditor": {
      "name": "Security Reviewer",
      "runtime": "claude-code",
      "model": "sonnet",
      "prompt": "prompts/review.md",
      "botTokenEnv": "SLACK_BOT_TOKEN_SECURITY_AUDITOR",
      "appTokenEnv": "SLACK_APP_TOKEN_SECURITY_AUDITOR",
      "tools": [
        "Read",
        "Grep",
        "Glob",
        "Bash(git diff *)",
        "Bash(git log *)",
        "Bash(git show *)",
        "Bash(git -C * diff *)",
        "Bash(git -C * log *)",
        "Bash(git -C * show *)"
      ]
    },
    "frontend": {
      "name": "Frontend Agent",
      "runtime": "claude-code",
      "model": "sonnet",
      "prompt": "prompts/implement.md",
      "botTokenEnv": "SLACK_BOT_TOKEN_FRONTEND",
      "appTokenEnv": "SLACK_APP_TOKEN_FRONTEND",
      "tools": [
        "Read",
        "Write",
        "Edit",
        "Grep",
        "Glob",
        "Bash(npm *)",
        "Bash(git *)",
        "Bash(ls *)"
      ]
    },
    "infrastructure": {
      "name": "Infrastructure Agent",
      "runtime": "claude-code",
      "model": "sonnet",
      "prompt": "prompts/infrastructure.md",
      "botTokenEnv": "SLACK_BOT_TOKEN_INFRASTRUCTURE",
      "appTokenEnv": "SLACK_APP_TOKEN_INFRASTRUCTURE",
      "tools": [
        "Read",
        "Write",
        "Edit",
        "Grep",
        "Glob",
        "Bash(git status *)",
        "Bash(git diff *)",
        "Bash(git log *)",
        "Bash(git show *)",
        "Bash(ls *)",
        "Bash(python3 ${teams}/skills/service-build/scripts/client.py *)"
      ],
      "capabilities": "服務建置：在管理者登錄的目標部署、啟動與健康檢查；目標為 sandbox（prepare 收據 mode=sandbox）時，依 service-build skill 自行撰寫並以 client.py exec 執行安裝、啟動與修復腳本，不限技術棧。"
    }
  },
  "entry": "intake",
  "sharedInstructions": "prompts/shared.md",
  "maxTransitions": 24,
  "nodes": {
    "intake": {
      "kind": "AGENT",
      "role": "coordinator",
      "schema": "schemas/requirements.json",
      "scope": "READ_ONLY",
      "gate": "REQUIREMENTS",
      "workspace": false,
      "writablePaths": [],
      "plan": null,
      "next": "plan",
      "blocked": "human",
      "routes": {
        "question": "end",
        "implementation": "plan",
        "human": "human",
        "service": "service"
      },
      "requires": [],
      "maxVisits": 3,
      "timeoutSeconds": 900,
      "maxTurns": 40
    },
    "plan": {
      "kind": "AGENT",
      "role": "tester",
      "schema": "schemas/plan.json",
      "scope": "READ_ONLY",
      "gate": "TEST_PLAN",
      "workspace": false,
      "writablePaths": [],
      "plan": null,
      "next": "implementation",
      "blocked": "triage",
      "routes": {},
      "requires": [
        "intake"
      ],
      "maxVisits": 3,
      "timeoutSeconds": 900,
      "maxTurns": 40,
      "instructions": "prompts/plan.md"
    },
    "implementation": {
      "kind": "AGENT",
      "role": "builder",
      "schema": "schemas/implementation.json",
      "scope": "WORKSPACE",
      "gate": "IMPLEMENTATION",
      "workspace": true,
      "writablePaths": [],
      "plan": null,
      "next": "frontend",
      "blocked": "triage",
      "routes": {},
      "requires": [
        "plan"
      ],
      "maxVisits": 3,
      "timeoutSeconds": 1800,
      "maxTurns": 80
    },
    "verification": {
      "kind": "AGENT",
      "role": "tester",
      "schema": "schemas/verification.json",
      "scope": "LIMITED",
      "gate": "VERIFICATION",
      "workspace": true,
      "writablePaths": [
        "tests/**",
        "node_modules/**",
        "coverage/**",
        "dist/**"
      ],
      "plan": "plan",
      "next": "review",
      "blocked": "triage",
      "routes": {},
      "requires": [
        "plan",
        "frontend"
      ],
      "maxVisits": 3,
      "timeoutSeconds": 1800,
      "maxTurns": 60
    },
    "review": {
      "kind": "AGENT",
      "role": "security_auditor",
      "schema": "schemas/review.json",
      "scope": "READ_ONLY",
      "gate": "REVIEW",
      "workspace": true,
      "writablePaths": [],
      "plan": null,
      "next": "approval",
      "blocked": "triage",
      "routes": {},
      "requires": [
        "verification"
      ],
      "maxVisits": 3,
      "timeoutSeconds": 900,
      "maxTurns": 40
    },
    "triage": {
      "kind": "AGENT",
      "role": "coordinator",
      "schema": "schemas/analysis.json",
      "scope": "READ_ONLY",
      "gate": "REPORT",
      "workspace": false,
      "writablePaths": [],
      "plan": null,
      "next": "human",
      "blocked": "human",
      "routes": {
        "implementation": "implementation",
        "verification": "verification",
        "human": "human",
        "requirements": "intake",
        "plan": "plan",
        "service": "deploy"
      },
      "requires": [],
      "maxVisits": 3,
      "timeoutSeconds": 900,
      "maxTurns": 40,
      "instructions": "prompts/triage.md"
    },
    "approval": {
      "kind": "APPROVAL",
      "requires": [
        "intake",
        "implementation",
        "plan",
        "verification",
        "review",
        "frontend"
      ]
    },
    "frontend": {
      "kind": "AGENT",
      "role": "frontend",
      "schema": "schemas/implementation.json",
      "scope": "WORKSPACE",
      "gate": "IMPLEMENTATION",
      "workspace": true,
      "writablePaths": [],
      "plan": null,
      "next": "verification",
      "blocked": "triage",
      "routes": {},
      "requires": [
        "implementation",
        "plan"
      ],
      "maxVisits": 3,
      "timeoutSeconds": 1800,
      "maxTurns": 80
    },
    "service": {
      "kind": "AGENT",
      "role": "infrastructure",
      "schema": "schemas/service.json",
      "scope": "LIMITED",
      "gate": "SERVICE",
      "workspace": true,
      "writablePaths": [
        "ai-team-sandbox/**"
      ],
      "plan": null,
      "next": "end",
      "blocked": "service_triage",
      "routes": {},
      "requires": [
        "intake"
      ],
      "maxVisits": 3,
      "timeoutSeconds": 1800,
      "maxTurns": 60,
      "instructions": "prompts/service.md",
      "skills": [
        "skills/service-build/SKILL.md"
      ]
    },
    "deploy": {
      "kind": "AGENT",
      "role": "infrastructure",
      "schema": "schemas/service.json",
      "scope": "LIMITED",
      "gate": "SERVICE",
      "workspace": true,
      "writablePaths": [
        "ai-team-sandbox/**"
      ],
      "plan": null,
      "next": "review",
      "blocked": "triage",
      "routes": {},
      "requires": [
        "intake",
        "verification"
      ],
      "maxVisits": 3,
      "timeoutSeconds": 1800,
      "maxTurns": 60,
      "instructions": "prompts/service.md",
      "skills": [
        "skills/service-build/SKILL.md"
      ]
    },
    "service_triage": {
      "kind": "AGENT",
      "role": "coordinator",
      "schema": "schemas/analysis.json",
      "scope": "READ_ONLY",
      "gate": "REPORT",
      "workspace": false,
      "writablePaths": [],
      "plan": null,
      "next": "human",
      "blocked": "human",
      "routes": {
        "service": "service",
        "human": "human"
      },
      "requires": [
        "intake"
      ],
      "maxVisits": 3,
      "timeoutSeconds": 900,
      "maxTurns": 40,
      "instructions": "prompts/service-triage.md",
      "skills": [
        "skills/service-build/SKILL.md"
      ]
    }
  }
}
