{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "verdict",
    "summary",
    "verify_passed",
    "scenario_results",
    "findings",
    "uncertainties",
    "baseline_revision",
    "plan_revision"
  ],
  "properties": {
    "verdict": {
      "type": "string",
      "enum": [
        "PASS",
        "FAIL"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "verify_passed": {
      "type": "boolean"
    },
    "scenario_results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "scenario_id",
          "status",
          "actual_result",
          "evidence",
          "command"
        ],
        "properties": {
          "scenario_id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "minLength": 1
          },
          "actual_result": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          },
          "command": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "severity",
          "detail"
        ],
        "properties": {
          "severity": {
            "type": "string",
            "minLength": 1
          },
          "detail": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "uncertainties": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "baseline_revision": {
      "type": "string",
      "minLength": 1
    },
    "plan_revision": {
      "type": "string",
      "minLength": 1
    }
  }
}
