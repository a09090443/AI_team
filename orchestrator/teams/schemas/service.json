{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "summary",
    "target",
    "service_status",
    "product_code_changed",
    "checks",
    "uncertainties"
  ],
  "properties": {
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "target": {
      "type": "string"
    },
    "service_status": {
      "type": "string",
      "enum": [
        "RUNNING",
        "NOT_RUNNING"
      ]
    },
    "product_code_changed": {
      "type": "boolean"
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "operation_id",
          "status",
          "exit_code",
          "evidence",
          "acceptance_ids"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "operation_id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "PASS",
              "FAIL",
              "NOT_RUN"
            ]
          },
          "exit_code": {
            "type": [
              "integer",
              "null"
            ]
          },
          "evidence": {
            "type": "string"
          },
          "acceptance_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "uncertainties": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
